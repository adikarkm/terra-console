# Copy to .env and fill in.
# --- AI for Ask the Earth (pick one) ---------------------------------------------------------
# FREE: OpenRouter. Sign up at https://openrouter.ai, create a key at https://openrouter.ai/keys
# and paste it here. No card needed. Free limits: about 20 requests a minute and 50 a day
# (1000 a day once you've ever bought $10 of credit). One question uses roughly 3-8 requests.
OPENROUTER_API_KEY=
# Optional: a specific free model (e.g. one ending in ":free" that supports tools). The default
# "openrouter/free" picks a free tool-capable model automatically for each request.
# OPENROUTER_MODEL=openrouter/free
# Optional: any OpenAI-compatible endpoint, e.g. Ollama on this PC: http://localhost:11434/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PAID: Claude (Anthropic API). Used instead of OpenRouter when set.
ANTHROPIC_API_KEY=
# Optional: model override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force a provider when both keys are set: openrouter or anthropic
# AI_PROVIDER=openrouter
PORT=3000
# Optional HTTPS for WebXR headsets / phones on your LAN (see docs/XR.md)
# CERT_FILE=./certs/cert.pem
# KEY_FILE=./certs/key.pem
# HTTPS_PORT=3443
# Optional: NASA FIRMS active fires (free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# FIRMS_MAP_KEY=
